# Copy this file to .env and paste your OpenRouter key.
# Never commit .env. Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default: OpenRouter's free-model router (picks a free model that supports your request)
OPENROUTER_MODEL=openrouter/free

# Used only if you want to pin a specific free model instead
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
